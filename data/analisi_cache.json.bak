  "astegiudiziarie:2301481": {
    "immobile_id": "astegiudiziarie:2301481",
    "analizzato_il": "2026-04-09T08:27:06.211020Z",
    "pagine_analizzate": 19,
    "fonte_pdf_url": "https://www.astegiudiziarie.it/allegato/perizia-fi-ei-245-2023-c-1.pdf/2301481",
    "indirizzo_estratto": "Via Silvio Pellico n.7, Pontassieve",
    "lotto_identificazione": "Lotto 1: Foglio 99, Particella 507, Sub 15 - Lotto 2: Foglio 99, Particella 507, Sub 24",
    "descrizione_immobile": "Il complesso immobiliare è situato in Via Silvio Pellico n.7 a Pontassieve, inserito in un fabbricato ad uso prevalentemente residenziale degli anni '60 costruito con struttura portante in cemento armato, finiture intonacate e tinteggiate, pareti interne parzialmente in mattoni pieni e mattoni forati e solai in latero-cemento con copertura a tetto a falde inclinate. Il Lotto 1 comprende un'unità immobiliare ad uso civile abitazione di 6,5 vani catastali che si sviluppa al piano primo con accesso dal vano scala condominiale. L'appartamento risulta internamente composto da ingresso/disimpegno, cucina, soggiorno, tre camere da letto, bagno finestrato e ripostiglio, oltre ad una terrazza fronte strada ed una tergale per una superficie calpestabile complessiva di 99,79 mq. Al piano seminterrato è presente una cantina di 4,30 mq. Il Lotto 2 è costituito da un'autorimessa al piano seminterrato di 11,40 mq con accesso carrabile dall'area comune tramite rampa di collegamento con la pubblica Via Fratelli Cervi n.102 e ingresso pedonale dallo stabile con accesso da Via Silvio Pellico n.7. Tutti i locali abitabili sono dotati di illuminazione naturale diretta con finestre che aprono sui lati fronte strada o tergali. La pavimentazione è principalmente in graniglia, le pareti interne e i soffitti sono intonacati e tinteggiati in normale stato di conservazione. La dotazione impiantistica è completa ma non verificata nella funzionalità, con impianto elettrico sottotraccia, riscaldamento condominiale con corpi in ghisa e certificazione impiantistica non reperita. L'immobile si trova in una zona ben servita con presenza di esercizi commerciali, strutture sociali, sanitarie, alimentari, scolastiche e di trasporto pubblico nelle vicinanze del centro abitato di Pontassieve.",
    "caratteristiche": {
      "superficie_mq": 118.09,
      "vani": 6.5,
      "bagni": 1,
      "piano": "1",
      "anno_costruzione": "1960",
      "classe_energetica": null,
      "stato_conservazione": "Normale",
      "riscaldamento": "centralizzato",
      "box_auto": "si",
      "ascensore": false,
      "balcone_terrazzo": true,
      "cantina": true,
      "giardino": false
    },
    "occupato": true,
    "titolo_opponibile": false,
    "dettagli_possesso": "Al momento del sopralluogo si è potuto accertare che l'immobile risulta occupato dagli esecutati, dal figlio e da sua moglie, come accertato anche dallo stato di famiglia che li vede tutti residenti in stessa sede. Non risulta in essere alcun contratto di locazione.",
    "abusi_edilizi": [
      {
        "descrizione": "Non risulta correttamente allineato lo stato catastale delle intestazioni e delle relative quote di proprietà, per carenza di deposito della Dichiarazione di Successione della signora deceduta e della conseguente Voltura Catastale",
        "sanabile": true,
        "costo_stima": 4000
      }
    ],
    "conformita_note": "Le licenze per l'edificazione del fabbricato sono state avviate in epoca antecedente al 1967 e successivamente completate ed avviate. Dal confronto con le licenze edilizie non si riscontrano difformità dal punto di vista urbanistico. Dal punto di vista catastale la planimetria in atti risulta correttamente rappresentata.",
    "prezzo_mercato": 220369.6,
    "fonte_prezzo_mercato": "Il sottoscritto stimatore, come accennato ai punti precedenti, moltiplicando la superficie SCV originata dal precedente conguaglio, per il valore unitario medio, otterrà così il Valore di Mercato del bene oggetto di stima: LOTTO 1 - VALORE DI MERCATO Superficie conguagliata SCV Mq 105,44 Valore unitario medio €/mq 2.090,00 TOTALE VALORE DI MERCATO € 220.369,60",
