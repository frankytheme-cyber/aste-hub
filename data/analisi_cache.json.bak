  "astalegale:B2403682": {
    "immobile_id": "astalegale:B2403682",
    "analizzato_il": "2026-04-10T09:35:02.141233Z",
    "pagine_analizzate": 44,
    "fonte_pdf_url": "https://documents.astalegale.net/file/0/3c8c21739fc22f8a7e151da473cf2e3f/139855-A?cd=true",
    "indirizzo_estratto": "Via Vallombrosana n. 79, Pelago (FI)",
    "lotto_identificazione": "Lotto N°1: Particelle 24 e 25 del Foglio 47. Lotto N°2: Particelle del Foglio 46",
    "descrizione_immobile": "Si tratta di un complesso immobiliare denominato \"Villa Volpaia\" situato in Via Vallombrosana n. 79 a Pelago, in località Paternò. La proprietà è composta da una villa padronale di vecchia costruzione risalente presumibilmente all'inizio del XIX secolo, suddivisa in due unità immobiliari ad uso abitativo. L'unità A1 si sviluppa al piano terreno e primo con una superficie utile di circa 214 mq, composta da dieci vani oltre accessori tra cui ingresso, soggiorno, pranzo-cucina, studio e disimpegno al piano terra, mentre al piano primo troviamo disimpegno, tre camere, tre bagni, sottoscala, locale guardaroba e balcone. L'unità A2 al piano secondo ha una superficie di circa 130 mq con sei vani oltre accessori. È presente anche una casa colonica di vecchia costruzione adiacente alla villa, anch'essa suddivisa in due unità immobiliari (B1 e B2). L'unità B1 al piano seminterrato ha superficie di circa 43 mq con annessa cantina di 7 mq e locale sbratto di 10,50 mq, mentre l'unità B2 al piano terra ha superficie di 105 mq con cinque vani. Completano la proprietà un garage di circa 25 mq, una cantina di circa 24,50 mq, terreni agricoli con presenza di oliveti e un annesso agricolo di circa 66 mq attualmente utilizzato come deposito. La villa presenta uno stato di manutenzione normale in rapporto alla vetustà, ma necessita di ripristino dell'intonaco su tutti e quattro i fronti. Gli immobienti sono dotati di impianto idrico, elettrico, fognario e di riscaldamento comune. L'accesso avviene da strada carrabile privata con cancello e la proprietà gode di una posizione panoramica nel territorio di Pelago.",
    "caratteristiche": {
      "superficie_mq": null,
      "vani": null,
      "bagni": null,
      "piano": "terreno, primo e secondo",
      "anno_costruzione": "inizio XIX secolo",
      "classe_energetica": null,
      "stato_conservazione": "normale in rapporto alla vetustà ma necessita interventi",
      "riscaldamento": "comune",
      "box_auto": "garage",
      "ascensore": false,
      "balcone_terrazzo": true,
      "cantina": true,
      "giardino": true
    },
    "occupato": true,
    "titolo_opponibile": false,
    "dettagli_possesso": "La casa padronale al momento del sopralluogo risultava abitata dal signore, l'appartamento al primo piano risultava attualmente non abitato ma comunque a disposizione dei signori. Le abitazioni della casa colonica risultavano al momento del sopralluogo entrambe inutilizzate. Garage e cantina risultano in uso ai signori. Terreni agricoli risultano in uso ai signori.",
    "abusi_edilizi": [],
    "conformita_note": "Dalle verifiche effettuate presso l'Ufficio tecnico del Comune di Pelago gli edifici risultano conformi alla vigente normativa urbanistico edilizia in quanto sono stati edificati antecedentemente al 01/09/1967 e non risultano in atti, progetti o istanze edilizie che ne determinino una diversa consistenza. La villa è stata oggetto di richiesta di Concessione edilizia in sanatoria presentata in data 10/09/1986 assunta al protocollo con il n. 9663, relativa ad opere interne ed esterne realizzate nell'edificio principale, rilasciata dal Comune di pelago in data 16/05/1997. I fabbricati non risultano vincolati ai sensi della L. 1089/1939 e successive modifiche, aggiornamenti ed integrazioni.",
    "prezzo_mercato": 1536785,
    "fonte_prezzo_mercato": "TOTALE VALORE STIMATO = € 1.536.785,00 (diciconsi euro unmilionecinquecentotrentaseimilasettecentottantacinque/00)",
    "costi_sanatoria": null,
